# Store every text file as LF in the repository, and check it out as LF too.
# `eol=lf` (rather than bare `text=auto`) means the working tree matches on
# Windows and macOS, so switching machines never rewrites whole files.
* text=auto eol=lf

# Xcode project/workspace files. Passaggio.xcodeproj is generated by XcodeGen
# and gitignored today, but keep these so a checked-in project can't be broken
# by a stray CRLF. merge=union keeps both sides' added lines on a conflict --
# the result still needs opening in Xcode to confirm it's valid.
*.pbxproj        text eol=lf merge=union
*.xcworkspacedata text eol=lf
*.xcscheme       text eol=lf
*.xcconfig       text eol=lf
*.plist          text eol=lf
*.storyboard     text eol=lf
*.xib            text eol=lf
*.strings        text eol=lf
*.entitlements   text eol=lf

# Tools that choke on CRLF (make recipes, shebang lines).
Makefile text eol=lf
*.mk     text eol=lf
*.sh     text eol=lf
*.py     text eol=lf

# Audio and other binary assets: never transform, never diff as text.
*.wav  binary
*.m4a  binary
*.mp3  binary
*.aac  binary
*.aiff binary
*.caf  binary
*.sf2  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.pdf  binary
*.xcuserstate binary

# Nicer diff hunk headers.
*.swift diff=swift
